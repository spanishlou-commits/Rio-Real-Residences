Options -Indexes

# No-cache for pages; long-cache for static assets
SetEnvIfNoCase Request_URI "\.(css|js|jpg|jpeg|png|gif|svg|webp|woff2|woff|ico)$" is_static
Header always set Cache-Control "no-cache, no-store, must-revalidate" env=!is_static
Header always set Pragma "no-cache" env=!is_static
Header always set Expires "0" env=!is_static
Header always set Cache-Control "public, max-age=31536000, immutable" env=is_static

RewriteEngine On

# Redirect www to non-www (canonical domain)
RewriteCond %{HTTP_HOST} ^www\.riorealresidences\.com [NC]
RewriteRule ^ https://riorealresidences.com%{REQUEST_URI} [R=301,L]

# Redirect old property template URL to new standalone page
RewriteCond %{QUERY_STRING} id=rrr-002
RewriteRule ^property$ /jardines-de-las-lomas? [R=301,L]

# Redirect /index and /index.html to root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?\s [NC]
RewriteRule ^ / [R=301,L]

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]
