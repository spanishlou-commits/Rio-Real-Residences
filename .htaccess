Options -Indexes

# Prevent HTML pages from being cached by browsers
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# Cache static assets aggressively (CSS, JS, images)
<FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|woff2|woff)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

RewriteEngine On

# Redirect /index and /index.html to root
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index(\.html)?\s [NC]
RewriteRule ^ / [R=301,L]

# Remove .html extension
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^\.]+)$ $1.html [NC,L]

# Redirect .html URLs to clean URLs
RewriteCond %{THE_REQUEST} /([^.]+)\.html [NC]
RewriteRule ^ /%1 [NC,L,R=301]
